# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# next dev --experimental-https
/certificates

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local scratch (screenshots, downloaded covers, debug dumps)
/tmp/
/.tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-video
videos/*
!videos/*.json
!videos/*.js
!videos/*.ts
public/_next-video

# agents / AI tooling
# Local assistant state and per-machine MCP wiring. None of it describes
# the site, and the MCP files in particular point at local commands and can
# end up holding tokens, so they stay out of the repo.
.agents/
.claude/
skills-lock.json
.mcp.json
**/mcp.json
.cursor/
.cursorrules
.cursorignore
.windsurf/
.windsurfrules
.aider*
.continue/
.codeium/
.gemini/
GEMINI.md
.roo/
.cline*
.opencode/
.crush/
.specstory/
.tabnine*
.github/copilot-instructions.md
CLAUDE.md
AGENTS.md
