# Public Sanity connection details (not secret — exposed in the client bundle).
# Use your own project ID and dataset from sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only token used for authenticated draft previews.
# Use a Viewer token. Leave unset until preview is configured.
SANITY_API_READ_TOKEN=

# Editor token for local migration/seed scripts only.
# Never add this to a deployed environment.
SANITY_API_WRITE_TOKEN=

# Optional integrations already used by the site.
NEXT_PUBLIC_GA_ID=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
